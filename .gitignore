/panmail
/panmail.db
/panmail_no_ui
/logs.db/
/inbound.db/
/events.db/
/.junie/*
/.rtk/
/.serena/
/.idea

# Everything scripts/dev.sh creates: the development config (which holds a
# PASETO key and, on PostgreSQL, an encrypted database password), the database,
# the Pebble stores, the generated admin password and the compiled binary.
/.dev/

# Generated knowledge-graph artefacts, including a per-file AST cache. Rebuilt
# from the source it describes, so committing it only produces merge conflicts.
/graphify-out/

# Per-developer tool configuration.
/.ai/

# Event log archives written at runtime; these are tenant data, not source.
/archives/

# Test binaries left behind by `go test -c` and profiling runs.
*.test

# goreleaser's output. Built from the tag, so committing it would ship a
# snapshot of one machine's binaries as though they were the release.
/dist/
