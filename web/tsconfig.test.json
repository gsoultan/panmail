{
  // Tests are excluded from tsconfig.app.json because they are not part of the
  // shipped bundle and they import `bun:test`. They still get type-checked, via
  // this project — `tsc -b` builds both, so a test that no longer matches the
  // code it covers fails the build rather than only failing at run time.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["bun", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "test-setup.ts"]
}
